+    // Candidate extension: validate identity and enqueue in one app event. An OK
+    // response acknowledges queue acceptance only, not PTY/application execution.
+    pub(super) fn handle_pocket_input_capabilities(&self, id: String) -> String {
+        encode_success(id, ResponseResult::PocketInputCapabilities {
+            version: 1, protocol: crate::protocol::PROTOCOL_VERSION,
+            atomic_terminal_guard: true, raw_bytes: true, max_input_bytes: 4096,
+        })
+    }
+
+    pub(super) fn handle_pocket_input_send(&mut self, id: String, params: crate::api::schema::PocketInputSendParams) -> String {
+        use base64::Engine as _;
+        let reject = |id| encode_error(id, "pocket_input_rejected", "input rejected before enqueue");
+        if id.len()!=32 || !id.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) || params.bytes_base64.len()>5464 {
+            return reject(id);
+        }
+        let Ok(bytes)=base64::engine::general_purpose::STANDARD.decode(&params.bytes_base64) else { return reject(id); };
+        if bytes.is_empty() || bytes.len()>4096 || base64::engine::general_purpose::STANDARD.encode(&bytes)!=params.bytes_base64 { return reject(id); }
+        let Some((ws_idx,pane_id))=self.parse_pane_id(&params.pane_id) else { return reject(id); };
+        if self.public_pane_id(ws_idx,pane_id).as_deref()!=Some(params.pane_id.as_str()) { return reject(id); }
+        let Some(actual)=self.state.terminal_id_for_pane(ws_idx,pane_id) else { return reject(id); };
+        if actual.to_string()!=params.expected_terminal_id { return reject(id); }
+        let Some(runtime)=self.lookup_runtime_sender(ws_idx,pane_id) else { return reject(id); };
+        if runtime.validate_input_submission(&bytes).is_err() { return reject(id); }
+        let accepted_bytes=bytes.len();
+        if runtime.try_send_bytes(Bytes::from(bytes)).is_err() { return reject(id); }
+        encode_success(id, ResponseResult::PocketInputAccepted { pane_id:params.pane_id, terminal_id:params.expected_terminal_id, accepted_bytes })
+    }
