+                .expect("frame timeout"),
+        ) else {
+            panic!("attach frame")
+        };
+        assert!(!attached.bytes.windows(5).any(|bytes| bytes == b"\x1b[?1h"));
+        assert!(!attached
+            .bytes
+            .windows(8)
+            .any(|bytes| bytes == b"\x1b[?2004h"));
+        assert!(server.clients[&73].observer_input_modes.is_none());
+    });
+}
