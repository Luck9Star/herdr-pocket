+#[cfg(unix)]
+#[test]
+fn unreadable_observer_modes_close_only_that_observer_without_false_modes() {
+    with_terminal_session_test_server(|server, terminal_id, target, _| {
+        let (writer, control, frames) = test_client_writer();
+        server.handle_server_event(ServerEvent::ClientConnected {
+            client_id: 70,
+            cols: 80,
+            rows: 24,
+            cell_width_px: 0,
+            cell_height_px: 0,
+            pixel_mouse: false,
+            writer,
+        });
+        assert!(
+            server.handle_server_event(ServerEvent::ClientObserveTerminal {
+                client_id: 70,
+                target: target.clone(),
+            })
+        );
+        server.render_and_stream();
+        let _ = frames
+            .recv_timeout(Duration::from_secs(2))
+            .expect("frame timeout");
+        let (attach_writer, _attach_control, _attach_frames) = test_client_writer();
+        server.clients.insert(
+            73,
+            ClientConnection::new_with_mode(
+                ClientConnectionMode::TerminalAttach {
+                    terminal_id: target,
+                },
+                (80, 24),
+                crate::kitty_graphics::HostCellSize::default(),
+                0,
+                RenderEncoding::TerminalAnsi,
+                Some(attach_writer),
+            ),
+        );
+        server
+            .app
+            .terminal_runtimes
+            .get(&terminal_id)
+            .unwrap()
+            .test_poison_observer_mode_lock();
+        server.render_and_stream();
+        assert!(!server.clients.contains_key(&70));
+        assert!(server.clients.contains_key(&73));
+        assert!(frames.try_recv().is_err());
+        assert_eq!(
+            read_server_shutdown_reason(
+                control
+                    .recv_timeout(Duration::from_secs(2))
+                    .expect("frame timeout")
+            ),
+            Some("terminal observe ended: input mode unavailable".to_owned())
+        );
+    });
+}
