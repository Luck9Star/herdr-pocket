+    #[tokio::test]
+    async fn pocket_input_guards_identity_rejects_bad_bytes_and_never_resizes() {
+        use crate::api::schema::{Method, PocketInputSendParams, Request};
+        let (mut app, pane, mut rx) = app_with_send_key_runtime(1);
+        let raw_pane=app.state.workspaces[0].tabs[0].root_pane;
+        let terminal=app.state.terminal_id_for_pane(0,raw_pane).unwrap().to_string();
+        let req=|expected: &str, raw: &str| Request { id: "0123456789abcdef0123456789abcdef".into(), method: Method::PocketInputSend(PocketInputSendParams { pane_id:pane.clone(), expected_terminal_id:expected.into(), bytes_base64:raw.into() }) };
+        let rejected=app.handle_api_request(req("term_wrong","QQ=="));
+        assert!(rejected.contains("pocket_input_rejected")); assert!(rx.try_recv().is_err());
+        let rejected=app.handle_api_request(req(&terminal,"QQ"));
+        assert!(rejected.contains("pocket_input_rejected")); assert!(rx.try_recv().is_err());
+        let accepted=app.handle_api_request(req(&terminal,"QeaWhw=="));
+        let response: SuccessResponse=serde_json::from_str(&accepted).unwrap();
+        assert_eq!(response.result, ResponseResult::PocketInputAccepted { pane_id:pane.clone(), terminal_id:terminal.clone(), accepted_bytes:4 });
+        let full=app.handle_api_request(req(&terminal,"Qg=="));
+        assert!(full.contains("pocket_input_rejected"));
+        assert_eq!(rx.try_recv().unwrap(), bytes::Bytes::from_static("A文".as_bytes()));
+        assert!(rx.try_recv().is_err());
+        use base64::Engine as _;
+        let too_large=base64::engine::general_purpose::STANDARD.encode(vec![b'x';4097]);
+        assert!(app.handle_api_request(req(&terminal,&too_large)).contains("pocket_input_rejected"));
+        assert!(rx.try_recv().is_err());
+        app.state.workspaces[0].pane_state_mut(raw_pane).unwrap().attached_terminal_id=crate::terminal::TerminalId::alloc();
+        assert!(app.handle_api_request(req(&terminal,"QQ==")).contains("pocket_input_rejected"));
+        assert!(rx.try_recv().is_err());
+        assert!(!app.state.direct_attach_resize_locks.contains(&app.state.terminal_id_for_pane(0,raw_pane).unwrap()));
+    }
