+// herdr-pocket pinned lwIP socket boundary. No system socket/DNS fallback.
+#include "hp_zt_bound.h"
+#include "lwip/sockets.h"
+#include <mutex>
+#include <cstring>
+namespace {
+// libzt's errno can be process-global. Serialize only individual nonblocking
+// socket calls and their errno capture, never a peer wait or manager control.
+std::mutex& io_mutex() { static std::mutex m; return m; }
+int outcome(int value) {
+    if (value >= 0) { return HP_ZT_BOUND_OK; }
+    return hp_zt_lwip_again() ? HP_ZT_BOUND_AGAIN : HP_ZT_BOUND_ERROR;
+}
+}
+extern "C" {
+int hp_zt_bound_open(uint64_t network, const uint8_t* ip, uint32_t length,
+                    uint16_t port, int* fd, uint64_t* epoch) {
+    *fd=-1; *epoch=0;
+    if (!ip || (length!=4 && length!=16) || !port) { return HP_ZT_BOUND_ERROR; }
+    std::lock_guard<std::mutex> lock(io_mutex());
+    *fd=lwip_socket(length==4 ? AF_INET : AF_INET6, SOCK_STREAM, IPPROTO_TCP);
+    if (*fd<0) { return HP_ZT_BOUND_ERROR; }
+    if (lwip_fcntl(*fd,F_SETFL,O_NONBLOCK)!=0) { return HP_ZT_BOUND_ERROR; }
+    int result=hp_zt_lwip_bind(*fd,network,ip,length,epoch);
+    if (result!=HP_ZT_BOUND_OK) { return result; }
+    if (length==4) {
+        struct sockaddr_in address={}; address.sin_len=sizeof(address); address.sin_family=AF_INET;
+        address.sin_port=lwip_htons(port); std::memcpy(&address.sin_addr.s_addr,ip,4);
+        return outcome(lwip_connect(*fd,reinterpret_cast<const struct sockaddr*>(&address),sizeof(address)));
+    }
+    struct sockaddr_in6 address={}; address.sin6_len=sizeof(address); address.sin6_family=AF_INET6;
+    address.sin6_port=lwip_htons(port); std::memcpy(address.sin6_addr.un.u32_addr,ip,16);
+    return outcome(lwip_connect(*fd,reinterpret_cast<const struct sockaddr*>(&address),sizeof(address)));
+}
+int hp_zt_bound_state(int fd,uint64_t network,uint64_t epoch) {
+    std::lock_guard<std::mutex> lock(io_mutex()); return hp_zt_lwip_state(fd,network,epoch);
+}
+int hp_zt_bound_read(int fd,uint8_t* data,uint32_t cap,uint32_t* count) {
+    std::lock_guard<std::mutex> lock(io_mutex()); *count=0;
+    const int value=static_cast<int>(lwip_recv(fd,data,cap,MSG_DONTWAIT));
+    if (value>=0) { *count=static_cast<uint32_t>(value); }
+    return outcome(value);
+}
+int hp_zt_bound_write(int fd,const uint8_t* data,uint32_t length,uint32_t* count) {
+    std::lock_guard<std::mutex> lock(io_mutex()); *count=0;
+    const int value=static_cast<int>(lwip_send(fd,data,length,MSG_DONTWAIT));
+    if (value>=0) { *count=static_cast<uint32_t>(value); }
+    return outcome(value);
+}
+int hp_zt_bound_shutdown_write(int fd) {
+    std::lock_guard<std::mutex> lock(io_mutex()); return outcome(lwip_shutdown(fd,SHUT_WR));
+}
+int hp_zt_bound_close(int fd) {
+    std::lock_guard<std::mutex> lock(io_mutex()); return outcome(lwip_close(fd));
+}
+}
