--- a/ext/lwip/src/api/sockets.c
+++ b/ext/lwip/src/api/sockets.c
@@ -4160,3 +4160,62 @@
 #endif /* LWIP_IPV6_MLD */
 
 #endif /* LWIP_SOCKET */
+
+
+/* herdr-pocket private network/generation bind. Atomically choose the real
+ * route/source and bind the TCP PCB while the core lock excludes reconfigure. */
+#include "hp_zt_bound.h"
+int hp_zt_lwip_bind(int fd, uint64_t network, const uint8_t* bytes, uint32_t length, uint64_t* epoch)
+{
+  struct lwip_sock* sock = get_socket(fd);
+  ip_addr_t dest, source;
+  struct netif* n;
+  int result = HP_ZT_BOUND_ROUTE;
+  if (!sock) { return HP_ZT_BOUND_ERROR; }
+  if (length == 4) { IP_SET_TYPE_VAL(dest, IPADDR_TYPE_V4); memcpy(&ip_2_ip4(&dest)->addr, bytes, 4); }
+  else if (length == 16) { ip_addr_set_zero_ip6(&dest); memcpy(ip_2_ip6(&dest)->addr, bytes, 16); }
+  else { done_socket(sock); return HP_ZT_BOUND_ERROR; }
+  LOCK_TCPIP_CORE();
+  n = hp_zt_route_locked(network, &dest, &source);
+  if (n && NETCONNTYPE_GROUP(netconn_type(sock->conn)) == NETCONN_TCP && sock->conn->pcb.tcp) {
+    tcp_bind_netif(sock->conn->pcb.tcp, n);
+    if (tcp_bind(sock->conn->pcb.tcp, &source, 0) == ERR_OK) {
+      *epoch=n->hp_generation;
+      sock->hp_network=network; sock->hp_epoch=*epoch; sock->hp_index=netif_get_index(n); sock->hp_connected=0;
+      ip_addr_copy(sock->hp_dest,dest); ip_addr_copy(sock->hp_source,source);
+      result=HP_ZT_BOUND_OK;
+    } else { result=HP_ZT_BOUND_ERROR; }
+  }
+  UNLOCK_TCPIP_CORE();
+  done_socket(sock);
+  return result;
+}
+int hp_zt_lwip_state(int fd, uint64_t network, uint64_t epoch)
+{
+  struct lwip_sock* sock = get_socket(fd);
+  struct tcp_pcb* pcb;
+  struct netif* n;
+  ip_addr_t source;
+  int result=HP_ZT_BOUND_ERROR;
+  if (!sock) { return result; }
+  LOCK_TCPIP_CORE();
+  pcb=NETCONNTYPE_GROUP(netconn_type(sock->conn)) == NETCONN_TCP ? sock->conn->pcb.tcp : NULL;
+  n=hp_zt_route_locked(network,&sock->hp_dest,&source);
+  if (!n || !epoch || sock->hp_network!=network || sock->hp_epoch!=epoch ||
+      n->hp_generation!=epoch || netif_get_index(n)!=sock->hp_index ||
+      !ip_addr_cmp(&source,&sock->hp_source)) { result=HP_ZT_BOUND_ROUTE; }
+  else if (pcb && (pcb->hp_generation!=epoch || pcb->netif_idx!=sock->hp_index)) { result=HP_ZT_BOUND_ROUTE; }
+  else if (pcb && pcb->state == SYN_SENT) { result=HP_ZT_BOUND_AGAIN; }
+  else if (pcb && pcb->state >= ESTABLISHED) { sock->hp_connected=1; result=HP_ZT_BOUND_OK; }
+  else if (!pcb && sock->hp_connected) { result=HP_ZT_BOUND_OK; } /* recv reports EOF/reset. */
+  UNLOCK_TCPIP_CORE();
+  done_socket(sock);
+  return result;
+}
+
+/* Classify where lwIP's errno constants are defined. Host C++ headers can use
+ * different numeric values (e.g. Darwin EINPROGRESS=36 versus lwIP=115). */
+int hp_zt_lwip_again(void)
+{
+  return errno == EWOULDBLOCK || errno == EAGAIN || errno == EINPROGRESS;
+}
