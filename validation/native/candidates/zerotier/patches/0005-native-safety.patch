+// herdr-pocket (2026): the sender owns projected objects until enqueue succeeds.
+#ifndef HP_ZT_EVENT_OWNERSHIP_HPP
+#define HP_ZT_EVENT_OWNERSHIP_HPP
+#include "ZeroTierSockets.h"
+namespace ZeroTier {
+struct HpDeleteEvent {
+    template<class T> void operator()(T* object) const { delete object; }
+};
+inline bool hp_event_input_is_owned(unsigned int code) {
+    return code==ZTS_EVENT_ADDR_ADDED_IP4 || code==ZTS_EVENT_ADDR_ADDED_IP6 ||
+           code==ZTS_EVENT_ADDR_REMOVED_IP4 || code==ZTS_EVENT_ADDR_REMOVED_IP6;
+}
+template<class Delete>
+inline void hp_dispose_rejected_event(unsigned int code,void* object,const Delete& dispose) {
+    if (!object) { return; }
+    switch(code) {
+    case ZTS_EVENT_NODE_UP: case ZTS_EVENT_NODE_ONLINE: case ZTS_EVENT_NODE_OFFLINE:
+    case ZTS_EVENT_NODE_DOWN: case ZTS_EVENT_NODE_FATAL_ERROR:
+        dispose(static_cast<zts_node_info_t*>(object)); break;
+    case ZTS_EVENT_NETWORK_NOT_FOUND: case ZTS_EVENT_NETWORK_CLIENT_TOO_OLD:
+    case ZTS_EVENT_NETWORK_REQ_CONFIG: case ZTS_EVENT_NETWORK_ACCESS_DENIED:
+    case ZTS_EVENT_NETWORK_DOWN: case ZTS_EVENT_NETWORK_UPDATE:
+    case ZTS_EVENT_NETWORK_READY_IP4: case ZTS_EVENT_NETWORK_READY_IP6: case ZTS_EVENT_NETWORK_OK:
+        dispose(static_cast<zts_net_info_t*>(object)); break;
+    case ZTS_EVENT_ADDR_ADDED_IP4: case ZTS_EVENT_ADDR_ADDED_IP6:
+    case ZTS_EVENT_ADDR_REMOVED_IP4: case ZTS_EVENT_ADDR_REMOVED_IP6:
+        dispose(static_cast<zts_addr_info_t*>(object)); break;
+    case ZTS_EVENT_PEER_DIRECT: case ZTS_EVENT_PEER_RELAY: case ZTS_EVENT_PEER_UNREACHABLE:
+    case ZTS_EVENT_PEER_PATH_DISCOVERED: case ZTS_EVENT_PEER_PATH_DEAD:
+        dispose(static_cast<zts_peer_info_t*>(object)); break;
+    default:
+        // STORE input is borrowed. Events owns only the copy it makes itself.
+        break;
+    }
+}
