+// herdr-pocket (2026): shared retirement predicates, used by the real workers.
+#ifndef HP_ZT_LIFECYCLE_HPP
+#define HP_ZT_LIFECYCLE_HPP
+#include <mutex>
+#include <condition_variable>
+#include <chrono>
+namespace ZeroTier {
+class HpWorkers {
+public:
+ enum Worker { Service=0, Callback=1, Driver=2 };
+ bool begin(Worker worker) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (active_[worker]) { return false; }
+  active_[worker]=true; return true;
+ }
+ void finish(Worker worker) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  active_[worker]=false; changed_.notify_all();
+ }
+ bool active(Worker worker) const { std::lock_guard<std::mutex> lock(mutex_); return active_[worker]; }
+ bool node_quiet() const { std::lock_guard<std::mutex> lock(mutex_); return !active_[Service] && !active_[Callback]; }
+ bool wait_node(std::chrono::steady_clock::time_point deadline) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  return changed_.wait_until(lock,deadline,[this]{return !active_[Service] && !active_[Callback];});
+ }
+ bool wait_driver(std::chrono::steady_clock::time_point deadline) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  return changed_.wait_until(lock,deadline,[this]{return !active_[Driver];});
+ }
+private:
+ mutable std::mutex mutex_; std::condition_variable changed_; bool active_[3]={false,false,false};
+};
+// Failed native thread creation must retire only its own new admission.
+class HpLaunchGuard {
+public:
+ HpLaunchGuard(HpWorkers& workers,HpWorkers::Worker worker):workers_(workers),worker_(worker),admitted_(workers.begin(worker)),committed_(false){}
+ ~HpLaunchGuard(){if(admitted_ && !committed_){workers_.finish(worker_);}}
+ explicit operator bool() const{return admitted_;}
+ void commit(){committed_=true;}
+private:
+ HpWorkers& workers_; HpWorkers::Worker worker_; bool admitted_; bool committed_;
+ HpLaunchGuard(const HpLaunchGuard&)=delete; HpLaunchGuard& operator=(const HpLaunchGuard&)=delete;
+};
+extern HpWorkers hp_workers;
+bool hp_can_configure();
+// The core can receive frames on lwIP's thread. Retire new admissions before
+// deleting the Node, and wait without holding the lwIP core or service mutex.
+class HpFrameGate {
+public:
+ bool enter() { std::lock_guard<std::mutex> lock(mutex_); if (closed_) { return false; } ++active_; return true; }
+ void leave() { std::lock_guard<std::mutex> lock(mutex_); --active_; changed_.notify_all(); }
+ bool quiet() const { std::lock_guard<std::mutex> lock(mutex_); return active_==0; }
+ void retire() { std::lock_guard<std::mutex> lock(mutex_); closed_=true; }
+ void drain() { std::unique_lock<std::mutex> lock(mutex_); closed_=true; changed_.wait(lock,[this]{return active_==0;}); }
+private:
+ mutable std::mutex mutex_; std::condition_variable changed_; bool closed_=false; unsigned int active_=0;
+};
+class HpFrameLease {
+public:
+ explicit HpFrameLease(HpFrameGate& gate):gate_(gate),entered_(gate.enter()){}
+ ~HpFrameLease(){if(entered_){gate_.leave();}}
+ explicit operator bool() const{return entered_;}
+private:
+ HpFrameGate& gate_; bool entered_;
+ HpFrameLease(const HpFrameLease&)=delete; HpFrameLease& operator=(const HpFrameLease&)=delete;
+};
+}
