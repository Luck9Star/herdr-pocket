+// herdr-pocket (2026): bounded projection of the pinned core's larger arrays.
+#ifndef HP_ZT_EVENT_PROJECTION_HPP
+#define HP_ZT_EVENT_PROJECTION_HPP
+#include "ZeroTierSockets.h"
+#include "ZeroTierOne.h"
+#include <algorithm>
+#include <cstring>
+namespace ZeroTier {
+template<class D,size_t DN,class S,size_t SN>
+inline unsigned int hp_projection_count(unsigned int count,const D (&)[DN],const S (&)[SN]) {
+ return static_cast<unsigned int>(std::min(static_cast<size_t>(count),std::min(DN,SN)));
+}
+template<class Convert>
+inline void hp_project_network(zts_net_info_t& dst,const ZT_VirtualNetworkConfig& src,Convert convert) {
+ std::memset(&dst,0,sizeof(dst));
+ dst.net_id=src.nwid; dst.mac=src.mac;
+ std::memcpy(dst.name,src.name,std::min(sizeof(dst.name)-1,sizeof(src.name)));
+ dst.status=static_cast<zts_network_status_t>(src.status); dst.type=static_cast<zts_net_info_type_t>(src.type);
+ dst.mtu=src.mtu; dst.dhcp=src.dhcp; dst.bridge=src.bridge; dst.broadcast_enabled=src.broadcastEnabled;
+ dst.port_error=src.portError; dst.netconf_rev=src.netconfRevision;
+ dst.assigned_addr_count=hp_projection_count(src.assignedAddressCount,dst.assigned_addrs,src.assignedAddresses);
+ for(unsigned int i=0;i<dst.assigned_addr_count;++i){convert(&dst.assigned_addrs[i],&src.assignedAddresses[i]);}
+ dst.route_count=hp_projection_count(src.routeCount,dst.routes,src.routes);
+ for(unsigned int i=0;i<dst.route_count;++i){
+  convert(&dst.routes[i].target,&src.routes[i].target); convert(&dst.routes[i].via,&src.routes[i].via);
+  dst.routes[i].flags=src.routes[i].flags; dst.routes[i].metric=src.routes[i].metric;
+ }
+ dst.multicast_sub_count=hp_projection_count(src.multicastSubscriptionCount,dst.multicast_subs,src.multicastSubscriptions);
+ for(unsigned int i=0;i<dst.multicast_sub_count;++i){dst.multicast_subs[i].mac=src.multicastSubscriptions[i].mac;dst.multicast_subs[i].adi=src.multicastSubscriptions[i].adi;}
+}
+}
