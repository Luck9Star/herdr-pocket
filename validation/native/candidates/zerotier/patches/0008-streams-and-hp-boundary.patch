+// Posts work to the lwIP thread, which runs it with the core lock held.
+// Callers can hold NodeService::_nets_m while the lwIP thread enters the
+// config path already holding the core lock (eth_tx -> tapFrameHandler ->
+// core -> config callback), so this path must never take the core lock
+// itself -- that is exactly the ABBA edge being removed. The tcpip mbox is
+// a fixed 128-deep ring (SYS_MBOX_SIZE): ERR_MEM from tcpip_try_callback
+// means the ring is momentarily full (with MEMP_MEM_MALLOC=1 the message
+// allocation is a plain malloc, so it fails only under system OOM). Retry
+// briefly for transient fullness, then fall back to tcpip_callback: it
+// blocks only until the ring has a free slot -- it takes no core lock and
+// waits on no service mutex, so it cannot complete the ABBA cycle, and the
+// reverse-edge invariant (no core-lock holder ever waits on _nets_m)
+// guarantees the lwIP thread keeps draining the ring. Outside OOM the
+// fence therefore always lands in FIFO order -- it is never dropped.
+// Templatized on the message type so the OOM cleanup deletes a typed
+// pointer (deleting a void* is undefined and warns).
+template <typename T>
+static void hp_post(tcpip_callback_fn fn, T* ctx)
+{
+    for (unsigned i = 0; i < 8; ++i) {
+        if (tcpip_try_callback(fn, ctx) == ERR_OK) {
+            return;
+        }
+        sys_msleep(1);
+    }
+    if (tcpip_callback(fn, ctx) != ERR_OK) {
+        // Reached only when the message malloc itself failed (system OOM):
+        // free the message loudly rather than leak. The dropped fence
+        // recovers on the next config change, which posts a fresh one.
+        fprintf(stderr, "herdr-pocket: hp fence post failed under OOM; recovery at next config change\n");
+        delete ctx;
+    }
+}
