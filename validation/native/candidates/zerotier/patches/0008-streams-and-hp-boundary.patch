index 0000000..3a6e821
--- /dev/null
+++ b/src/HpBoundRoutes.cpp
@@ -0,0 +1,65 @@
+// herdr-pocket: caller holds the lwIP core lock. No service/tap pointer escapes.
+#include "hp_zt_bound.h"
+#include "lwip/netif.h"
+#include "lwip/ip.h"
+#include <algorithm>
+#include <cstring>
+static bool hp_reaches4(struct netif* n,const ip4_addr_t* dest)
+{
+    if (ip4_addr_isany_val(*netif_ip4_addr(n))) { return false; }
+    if (ip4_addr_netcmp(dest,netif_ip4_addr(n),netif_ip4_netmask(n))) { return true; }
+    const struct hp_zt_gateway4* best=NULL;
+    for (unsigned i=0;i<n->hp_route_count && i<128;++i) {
+        const struct hp_zt_gateway4* route=&n->hp_routes[i];
+        if (route->bits>32 || (ip4_addr_get_u32(dest)&route->mask)!=route->network) { continue; }
+        // Match the production gateway hook: first of equally specific routes.
+        if (!best || route->bits>best->bits) { best=route; }
+    }
+    if (!best) { return false; }
+    ip4_addr_t via; ip4_addr_set_u32(&via,best->via);
+    return !ip4_addr_isany_val(via) && ip4_addr_netcmp(&via,netif_ip4_addr(n),netif_ip4_netmask(n));
+}
+extern "C" struct netif* hp_zt_route_locked(uint64_t network, const ip_addr_t* dest, ip_addr_t* source)
+{
+    struct netif* found = NULL;
+    struct netif* n;
+    NETIF_FOREACH(n) {
+        if (!n->state || !n->hp_ready || !n->hp_generation || n->hp_network != network ||
+            !netif_is_up(n) || !netif_is_link_up(n)) { continue; }
+        bool reaches = false;
+        ip_addr_t local;
+        if (IP_IS_V4(dest) && n->name[0] == '4') {
+            const uint32_t host = lwip_ntohl(ip4_addr_get_u32(ip_2_ip4(dest)));
+            if (!host || (host >> 24) == 127 || (host >> 28) >= 14) { return NULL; }
+            if (!ip4_addr_isbroadcast(ip_2_ip4(dest), n) && hp_reaches4(n, ip_2_ip4(dest))) {
+                ip_addr_copy_from_ip4(local, *netif_ip4_addr(n));
+                reaches = true;
+            }
+        } else if (IP_IS_V6(dest) && n->name[0] == '6') {
+            const ip6_addr_t* remote = ip_2_ip6(dest);
+            if (ip6_addr_isany(remote) || ip6_addr_isloopback(remote) ||
+                ip6_addr_islinklocal(remote) || ip6_addr_ismulticast(remote) ||
+                ip6_addr_isipv4mappedipv6(remote) || !n->hp_prefix6 || n->hp_prefix6 > 128) { return NULL; }
+            for (int i=0; i<LWIP_IPV6_NUM_ADDRESSES; ++i) {
+                const ip6_addr_t* candidate = netif_ip6_addr(n,i);
+                if (!ip6_addr_isvalid(netif_ip6_addr_state(n,i)) || ip6_addr_isany(candidate) ||
+                    ip6_addr_islinklocal(candidate) || std::memcmp(candidate->addr,n->hp_source6,16)!=0) { continue; }
+                const uint8_t* a = reinterpret_cast<const uint8_t*>(candidate->addr);
+                const uint8_t* b = reinterpret_cast<const uint8_t*>(remote->addr);
+                unsigned bits=n->hp_prefix6; bool same=true;
+                for (unsigned j=0; bits && j<16; ++j) {
+                    const unsigned take=std::min(bits,8u);
+                    const uint8_t mask=static_cast<uint8_t>(0xffu << (8-take));
+                    if ((a[j]&mask)!=(b[j]&mask)) { same=false; break; }
