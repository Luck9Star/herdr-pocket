     use crate::{CryptoVec, cipher, mac};
 
     struct TestHandler;
+
+    #[test]
+    fn herdr_local_close_retires_both_indexes_without_queued_data() {
+        let (mut session, _sender, _reply) = keyboard_interactive_session();
+        let id = session.common.encrypted.as_mut().unwrap().new_channel(1024, 1024);
+        session.common.encrypted.as_mut().unwrap().channels.get_mut(&id).unwrap().confirmed = true;
+        let (sender, mut receiver) = channel(1);
+        session.channels.insert(id, ChannelRef::new(sender));
+        session.handle_msg(Msg::Channel(id, ChannelMsg::Close)).unwrap();
+        assert!(!session.common.encrypted.as_ref().unwrap().channels.contains_key(&id));
+        assert!(!session.channels.contains_key(&id));
+        assert!(matches!(receiver.try_recv(), Err(tokio::sync::mpsc::error::TryRecvError::Disconnected)));
+    }
+
+    #[test]
+    fn herdr_local_close_pending_data_disconnects_instead_of_false_retirement() {
+        let (mut session, _sender, _reply) = keyboard_interactive_session();
+        let id = session.common.encrypted.as_mut().unwrap().new_channel(0, 1024);
+        let entry = session.common.encrypted.as_mut().unwrap().channels.get_mut(&id).unwrap();
+        entry.confirmed = true;
+        entry.pending_data.push_back((bytes::Bytes::from_static(b"unsettled"), None, 0));
+        let (sender, mut receiver) = channel(1);
+        session.channels.insert(id, ChannelRef::new(sender));
+        assert!(matches!(session.handle_msg(Msg::Channel(id, ChannelMsg::Close)), Err(crate::Error::Disconnect)));
+        // The driver must terminate, not report a successful local close while
+        // the encrypted pending queue remains alive. Driver drop drains both.
+        assert!(session.common.encrypted.as_ref().unwrap().has_pending_data(id));
+        drop(session);
+        assert!(matches!(receiver.try_recv(), Err(tokio::sync::mpsc::error::TryRecvError::Disconnected)));
+    }
 
